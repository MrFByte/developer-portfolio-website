---
interface NavItem {
  id: string;
  label: string;
  icon: string;
}

const items: NavItem[] = [
  { id: 'home', label: 'Home', icon: 'M3 11.5 12 4l9 7.5M5 9.5V20h5v-6h4v6h5V9.5' },
  { id: 'journey', label: 'Journey', icon: 'M12 3a9 9 0 1 0 .001 18.001A9 9 0 0 0 12 3Zm3.5 5.5-2 4.5-4.5 2 2-4.5 4.5-2Z' },
  { id: 'skills', label: 'Skills', icon: 'M13 2 4 14h6l-1 8 9-12h-6l1-8Z' },
  { id: 'projects', label: 'Projects', icon: 'M4 4h7v7H4V4Zm9 0h7v7h-7V4ZM4 13h7v7H4v-7Zm9 0h7v7h-7v-7Z' },
  { id: 'blog', label: 'Blog', icon: 'M6 2h9l5 5v15H6V2Zm9 0v5h5M9 13h6M9 17h6M9 9h2' },
  { id: 'contact', label: 'Contact', icon: 'm3 6 9 7 9-7M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z' },
];
---

<nav
  aria-label="Primary"
  class="fixed inset-x-0 bottom-0 z-50 border-t border-fog/15 bg-ink/90 backdrop-blur-md"
  style={`padding-bottom: env(safe-area-inset-bottom, 0px); height: var(--nav-safe-h);`}
>
  <div class="mx-auto flex h-[var(--nav-h)] max-w-[1800px] items-stretch">
    <div
      aria-hidden="true"
      class="hidden shrink-0 items-center justify-center border-r border-fog/15 bg-volt/10 px-5 sm:flex"
    >
      <span class="font-display text-sm tracking-widest text-volt">FM</span>
    </div>

    <ul class="flex flex-1 list-none items-stretch overflow-x-auto custom-scrollbar">
      {
        items.map((item) => (
          <li class="flex-1 min-w-[58px]">
            <a
              href={`#${item.id}`}
              data-nav-link
              data-target={item.id}
              class="group flex h-full w-full flex-col items-center justify-center gap-1 border-r border-fog/10 px-2 py-2 text-fog outline-none transition-colors duration-150 last:border-r-0 hover:text-chalk focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-volt data-[active=true]:bg-volt data-[active=true]:text-ink sm:flex-row sm:gap-2 sm:px-4"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="shrink-0"
                aria-hidden="true"
              >
                <path d={item.icon} />
              </svg>
              <span class="text-center text-[10px] font-bold uppercase leading-tight tracking-wider sm:text-xs sm:tracking-widest">
                {item.label}
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <div
      aria-hidden="true"
      data-availability
      class="hidden shrink-0 items-center gap-2 border-l border-fog/15 bg-ink px-5 sm:flex"
    >
      <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-volt" data-availability-dot></span>
      <span class="font-display text-[10px] uppercase tracking-widest text-fog" data-availability-text>Open to Work</span>
    </div>
  </div>
</nav>

<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]'));
  const sections = links
    .map((link) => document.getElementById(link.dataset.target ?? ''))
    .filter((el): el is HTMLElement => el !== null);

  function setActive(id: string) {
    links.forEach((link) => {
      if (link.dataset.target === id) {
        link.setAttribute('data-active', 'true');
        link.setAttribute('aria-current', 'true');
      } else {
        link.removeAttribute('data-active');
        link.removeAttribute('aria-current');
      }
    });
  }

  if (sections.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (visible?.target.id) setActive(visible.target.id);
      },
      { rootMargin: '-15% 0px -55% 0px', threshold: [0.1, 0.25, 0.5, 0.75] }
    );

    sections.forEach((section) => observer.observe(section));
    setActive(sections[0].id);
  }

  links.forEach((link) => {
    link.addEventListener('click', () => {
      if (link.dataset.target) setActive(link.dataset.target);
    });
  });
</script>
