---
interface Props {
  id: string;
  index: string;
  title: string;
  subtitle?: string;
}

const { id, index, title, subtitle } = Astro.props;
---

<section id={id} class="scroll-mt-10 px-4 py-20 sm:px-6 md:py-28 lg:px-12">
  <div class="mx-auto max-w-6xl">
    <div class="mb-10 flex items-end gap-4 md:mb-14">
      <span class="font-display text-xl text-volt/70 md:text-2xl">{index}</span>
      <div>
        <h2 class="text-balance font-display text-3xl uppercase leading-none tracking-tight text-chalk sm:text-4xl md:text-5xl">
          {title}
        </h2>
        {subtitle && <p class="mt-2 max-w-xl font-medium tracking-wide text-fog">{subtitle}</p>}
      </div>
      <div class="ml-2 h-px flex-1 bg-gradient-to-r from-volt/40 via-fog/15 to-transparent"></div>
    </div>

    <div class="panel-clip relative border border-fog/10 bg-panel/70 p-6 backdrop-blur-sm sm:p-8 md:p-10">
      <div class="absolute left-0 top-0 h-1 w-full bg-gradient-to-r from-volt to-transparent opacity-60"></div>
      <slot />
    </div>
  </div>
</section>
